{
  "expo": {
    "name": "OpenDoor",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.almoahat.opendoor",
      "appleTeamId": "87Z5GV5738",
      "infoPlist": {
        "NSCameraUsageDescription": "OpenDoor uses your camera only if you turn it on during a call.",
        "NSMicrophoneUsageDescription": "OpenDoor uses your microphone so you can talk during office hours calls."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
